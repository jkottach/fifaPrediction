# MongoDB (same cluster as prediction apps)
MONGODB_URI=mongodb+srv://user:pass@cluster.example.mongodb.net

# Admin API port (default 5002)
ADMIN_PORT=5002

# PIN required to open the admin UI (change in production)
ADMIN_PIN=12189

# Multi-tenant: id:dbName:Label,id:dbName:Label
# ADMIN_TENANTS=kanhans:fifaPrediction:Kanhans

# Or use tenants.config.json in admin-local/
