# Shared Atlas cluster (same URI for all tenants unless overridden per tenant in tenants.config.json)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?appName=Cluster0

# Fallback when tenants.config.json is missing (single-tenant mode)
MONGODB_DB=fifaPrediction

# Optional: comma-separated tenants instead of tenants.config.json
# ADMIN_TENANTS=kanhans:wc26Prod:Kanhans,fcc:wc26fcc:FCC,mandrake:wcmandrake:Mandrake
# ADMIN_DEFAULT_TENANT=kanhans

# Standalone admin API port (Vite proxies /api → this port)
ADMIN_PORT=5002
