# Copy to api/.env (local) or /opt/fifaPrediction/api/.env (EC2 production).
# Do not commit real secrets.

MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=fifaPrediction

JWT_SECRET=change_to_long_random_secret
JWT_EXPIRE=7d

GOOGLE_CLIENT_ID=your-fifa-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

NODE_ENV=production
# Custom domain OR sslip.io host, e.g. https://54-123-45-67.sslip.io (see AWS_DEPLOYMENT.md §1b)
FRONTEND_URL=https://your-host.example

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

PORT=5001
